{
  "name": "dsh-for-vscode",
  "displayName": "DeepSeek Harness for VS Code",
  "description": "DeepSeek Harness 的 VS Code 客户端:映射现有 dsh web 实例(127.0.0.1:3080)的 Agent UI",
  "version": "0.0.1",
  "publisher": "mrtsels",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrtsels/dsh-for-vs-code.git"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "deepseekHarness.open",
        "title": "DeepSeek Harness: Open"
      },
      {
        "command": "deepseekHarness.ask",
        "title": "DeepSeek Harness: Ask"
      },
      {
        "command": "deepseekHarness.review",
        "title": "DeepSeek Harness: Review Changes"
      },
      {
        "command": "deepseekHarness.setBaseUrl",
        "title": "DeepSeek Harness: 切换实例地址"
      },
      {
        "command": "deepseekHarness.switchSession",
        "title": "DeepSeek Harness: 切换会话",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "deepseekHarness.refreshSessions",
        "title": "DeepSeek Harness: 刷新会话列表",
        "icon": "$(refresh)"
      },
      {
        "command": "deepseekHarness.newSession",
        "title": "DeepSeek Harness: 新建会话(当前工作区)",
        "icon": "$(add)"
      },
      {
        "command": "deepseekHarness.explainSelection",
        "title": "dsh: 解释选中代码"
      },
      {
        "command": "deepseekHarness.fixDiagnostic",
        "title": "dsh: 修复此问题"
      },
      {
        "command": "deepseekHarness.fixDiagnosticFromMenu",
        "title": "dsh: Ask to fix 诊断"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "deepseekHarness.switchSession",
          "when": "false"
        },
        {
          "command": "deepseekHarness.refreshSessions",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "deepseekHarness.explainSelection",
          "when": "editorHasSelection",
          "group": "deepseekHarness@1"
        },
        {
          "command": "deepseekHarness.fixDiagnosticFromMenu",
          "when": "editorHasDiagnostics",
          "group": "deepseekHarness@2"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "deepseekHarness.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3080",
          "description": "dsh web 实例地址(插件连接现有实例,不拉起新实例;仅 127.0.0.1 受信任)"
        },
        "deepseekHarness.locale": {
          "type": "string",
          "enum": ["follow-web", "zh", "en"],
          "default": "follow-web",
          "enumDescriptions": [
            "跟随 dsh web UI(127.0.0.1:3080)当前语言设置;web 未显式设置时跟随系统/浏览器",
            "简体中文",
            "English"
          ],
          "description": "界面语言。默认跟随 web UI;选择具体语言会写回 dsh 实例设置并立即生效"
        },
        "deepseekHarness.theme": {
          "type": "string",
          "enum": ["follow-web", "light", "dark", "system"],
          "default": "follow-web",
          "enumDescriptions": [
            "跟随 dsh web UI 当前主题设置(默认跟随系统)",
            "浅色",
            "深色",
            "跟随系统"
          ],
          "description": "界面主题。默认跟随 web UI;选择具体主题会写回 dsh 实例设置并立即生效"
        }
      }
    },
    "chatParticipants": [
      {
        "id": "deepseekHarness.agent",
        "name": "deepseekharness",
        "fullName": "DeepSeek Harness",
        "description": "DeepSeek Harness agent(模型与工具由 dsh 实例提供)",
        "isSticky": true,
        "commands": [
          {
            "name": "new",
            "description": "新建会话(当前 VS Code 工作区)"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseekHarness",
          "title": "DeepSeek",
          "icon": "media/deepseek.svg"
        }
      ]
    },
    "views": {
      "deepseekHarness": [
        {
          "type": "webview",
          "id": "deepseekHarness.chat",
          "name": "Chat"
        },
        {
          "id": "deepseekHarness.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "deepseekHarness.sessions",
        "contents": "没有会话。启动 dsh web 实例(127.0.0.1:3080)后刷新。[刷新](command:deepseekHarness.refreshSessions)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deepseekHarness.newSession",
          "when": "view == deepseekHarness.sessions",
          "group": "navigation@1"
        },
        {
          "command": "deepseekHarness.refreshSessions",
          "when": "view == deepseekHarness.sessions",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "oxlint": "^0.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
