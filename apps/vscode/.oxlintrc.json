{
  "ignorePatterns": ["dist", "node_modules"],
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["web/**", "test/**"],
      "env": {
        "browser": true,
        "node": true
      }
    }
  ],
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "warn",
    "no-constant-binary-expression": "error",
    "no-unreachable": "error"
  }
}
