{
  "ignorePatterns": ["dist", "node_modules"],
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "warn",
    "no-constant-binary-expression": "error",
    "no-unreachable": "error",
    "no-undef": "off"
  }
}
